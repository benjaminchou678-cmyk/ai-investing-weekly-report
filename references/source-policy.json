{
  "schema_version": "2.0",
  "default_profile": "full_weekly",
  "wechat_discovery": {
    "primary_order": ["official_web_or_api", "mpscraper", "multi_query_search", "rss_fallback", "manual_ground_truth"],
    "search_query_date_terms_forbidden": true,
    "search_no_hit_confirms_no_update": false,
    "identity_required_for_selection": true,
    "published_at_required_for_automatic_selection": true,
    "c1_ground_truth_min_sources": 5,
    "c1_ground_truth_recommended_sources": 10
  },
  "profiles": {
    "full_weekly": {
      "hard_required_success_ratio": 0.7,
      "scheduled_c1_checked_ratio": 1.0,
      "c2_discovery_required": true,
      "scheduled_source_statuses": ["active", "unverified"],
      "endpoint_requirements": {
        "C1": {"min_configured": 1, "hard": true},
        "C2": {"min_configured": 1, "hard": false},
        "C3": {"min_configured": 0, "hard": false}
      },
      "attempt_requirements": {
        "C1": {"ratio": 1.0, "hard": true},
        "C2": {"ratio": 1.0, "hard": true}
      },
      "provider_concentration": {
        "max_success_share": 0.65
      },
      "registry_max_age_days": {
        "C1": 120,
        "C2": 240,
        "C3": 365
      },
      "schedule_rules": {
        "C1": "weekly required discovery",
        "C2": "weekly lightweight discovery (正文按需)",
        "C3": "event_driven"
      },
      "dimension_requirements": {
        "company_primary": {"min_checked": 4, "hard": true},
        "capital": {"min_checked": 3, "hard": true},
        "policy": {"min_checked": 2, "hard": true},
        "infrastructure": {"min_checked": 2, "hard": false},
        "customer_demand": {"min_checked": 1, "hard": false},
        "counter_evidence": {"min_checked": 1, "hard": false}
      },
      "independence": {
        "min_checked_groups": 6,
        "max_checked_share_per_group": 0.35
      }
    }
  }
}
